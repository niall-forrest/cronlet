generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum PlanTier {
  free
  pro
  team
}

enum MemberRole {
  owner
  admin
  member
  viewer
}

enum HandlerType {
  tools
  code
  webhook
}

enum ScheduleType {
  every
  daily
  weekly
  monthly
  once
  cron
}

enum RunStatus {
  queued
  leased
  running
  retry_wait
  success
  failure
  timeout
  cancelled
  dead_lettered
  terminal_client_error
  retry_window_expired
}

enum TaskSource {
  dashboard
  mcp
  sdk
}

enum TaskKind {
  scheduled
  dispatch
}

enum AlertChannel {
  email
  webhook
}

enum DispatchJobStatus {
  pending
  leased
  running
  retry_wait
  succeeded
  failed
  cancelled
  dead_lettered
}

enum RunAttemptStatus {
  pending
  running
  success
  failure
  timeout
  cancelled
  terminal_client_error
}

// ============================================
// USER & ORGANIZATION
// ============================================

model User {
  id          String               @id @default(cuid())
  clerkUserId String               @unique
  email       String               @unique
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  memberships OrganizationMember[]
}

model Organization {
  id            String               @id @default(cuid())
  clerkOrgId    String               @unique
  name          String
  slug          String               @unique
  callbackSigningSecret String?
  outboundAllowedHosts String[]      @default([])
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  memberships   OrganizationMember[]
  tasks         Task[]
  runs          Run[]
  dispatchJobs  DispatchJob[]
  circuitBreakers CircuitBreaker[]
  runAttempts   RunAttempt[]
  secrets       Secret[]
  alerts        Alert[]
  apiKeys       ApiKey[]
  auditEvents   AuditEvent[]
  usageCounters UsageCounter[]
  entitlement   BillingEntitlement?
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  role           MemberRole
  createdAt      DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
}

// ============================================
// TASK (replaces Endpoint + Job + Schedule)
// ============================================

model Task {
  id             String       @id @default(cuid())
  organizationId String
  kind           TaskKind     @default(scheduled)

  // Identity
  name           String
  description    String?
  externalId     String?

  // Handler: WHAT to do
  handlerType    HandlerType
  handlerConfig  Json

  // Schedule: WHEN to do it
  scheduleType   ScheduleType
  scheduleConfig Json
  timezone       String       @default("UTC")
  nextRunAt      DateTime?

  // Config: HOW to handle failures
  retryAttempts  Int          @default(1)
  retryBackoff   String       @default("linear")
  retryDelay     String       @default("1s")
  retryMaxAttempts Int        @default(10)
  retryInitialDelay String    @default("10s")
  retryMaxDelay  String       @default("15m")
  retryJitter    Boolean      @default(true)
  retryWindow    String       @default("24h")
  retryOnStatusCodes Int[]    @default([])
  terminalStatusCodes Int[]   @default([])
  timeout        String       @default("30s")

  // State
  active         Boolean      @default(true)
  source         TaskSource   @default(dashboard)

  // Tracking
  createdBy      Json?        // { type: "user" | "agent", id, name }

  // Agent callback - closes the autonomous loop
  callbackUrl    String?
  metadata       Json?        // Agent context stored with task
  maxRuns        Int?         // Auto-pause after N runs
  expiresAt      DateTime?    // Auto-pause after this time
  runCount       Int          @default(0)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  runs         Run[]
  dispatchJobs DispatchJob[]
  events       TaskEvent[]

  @@index([organizationId, active])
  @@index([active, nextRunAt])
  @@index([organizationId, kind, active])
  @@unique([organizationId, externalId])
}

// ============================================
// RUN (execution of a Task)
// ============================================

model Run {
  id             String    @id @default(cuid())
  organizationId String
  taskId         String

  // Execution
  status         RunStatus @default(queued)
  trigger        String    // "schedule" | "manual" | "api"
  attempt        Int       @default(1)

  // Timing
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?

  // Results
  output         Json?     // Structured result from handler
  logs           String?   // stdout/stderr
  errorMessage   String?

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  dispatchJobs DispatchJob[]
  attempts     RunAttempt[]
  events       RunEvent[]

  @@index([taskId, createdAt])
  @@index([organizationId, createdAt])
  @@index([organizationId, status, scheduledAt])
}

model RunAttempt {
  id                  String           @id @default(cuid())
  organizationId      String
  runId               String
  taskId              String
  dispatchJobId       String?
  attemptNumber       Int
  status              RunAttemptStatus @default(pending)
  startedAt           DateTime?
  completedAt         DateTime?
  durationMs          Int?
  httpStatus          Int?
  errorClass          String?
  errorMessage        String?
  responseBodyPreview String?
  responseBodyHash    String?
  output              Json?
  logs                String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  run          Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  dispatchJob  DispatchJob? @relation(fields: [dispatchJobId], references: [id], onDelete: SetNull)

  @@unique([runId, attemptNumber])
  @@index([organizationId, status, createdAt])
  @@index([dispatchJobId])
}

model DispatchJob {
  id                 String            @id @default(cuid())
  organizationId     String
  taskId             String
  runId              String
  status             DispatchJobStatus @default(pending)
  availableAt        DateTime          @default(now())
  leaseOwner         String?
  leasedUntil        DateTime?
  attemptCount       Int               @default(0)
  maxAttempts        Int               @default(10)
  retryWindowEndsAt  DateTime?
  lastError          String?
  destinationKey     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run          Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempts     RunAttempt[]
  events       DispatchEvent[]

  @@index([status, availableAt])
  @@index([organizationId, status, availableAt])
  @@index([destinationKey, status, availableAt])
  @@index([leasedUntil])
}

model CircuitBreaker {
  id                  String   @id @default(cuid())
  organizationId      String
  destinationKey      String
  state               String   @default("closed")
  consecutiveFailures Int      @default(0)
  openedAt            DateTime?
  cooldownUntil       DateTime?
  lastFailureAt       DateTime?
  lastFailureReason   String?
  probeInFlight       Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, destinationKey])
  @@index([organizationId, state, updatedAt])
}

model TaskEvent {
  id             String   @id @default(cuid())
  organizationId String
  taskId         String
  action         String
  previousState  String?
  nextState      String?
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([taskId, createdAt])
}

model RunEvent {
  id             String   @id @default(cuid())
  organizationId String
  runId          String
  action         String
  previousState  String?
  nextState      String?
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([runId, createdAt])
}

model DispatchEvent {
  id             String   @id @default(cuid())
  organizationId String
  dispatchJobId  String
  action         String
  previousState  String?
  nextState      String?
  reason         String?
  metadata       Json?
  createdAt      DateTime @default(now())

  dispatchJob DispatchJob @relation(fields: [dispatchJobId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([dispatchJobId, createdAt])
}

// ============================================
// SECRET (for tool credentials)
// ============================================

model Secret {
  id             String   @id @default(cuid())
  organizationId String
  name           String   // e.g., "SLACK_TOKEN"
  encryptedValue String
  keyVersion     String   @default("legacy")
  lastRotatedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
}

// ============================================
// ALERTS
// ============================================

model Alert {
  id             String       @id @default(cuid())
  organizationId String
  channel        AlertChannel
  destination    String
  onFailure      Boolean      @default(true)
  onTimeout      Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ============================================
// API KEYS
// ============================================

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  label          String
  keyHash        String
  scopes         String[]
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ============================================
// AUDIT
// ============================================

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  actorType      String
  actorId        String
  action         String
  targetType     String
  targetId       String
  payloadHash    String?
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// ============================================
// BILLING & USAGE
// ============================================

model UsageCounter {
  id             String   @id @default(cuid())
  organizationId String
  yearMonth      String
  runAttempts    Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, yearMonth])
}

model BillingEntitlement {
  id             String    @id @default(cuid())
  organizationId String    @unique
  tier           PlanTier  @default(free)
  delinquent     Boolean   @default(false)
  graceEndsAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model IdempotencyKey {
  id              String   @id @default(cuid())
  organizationId  String
  method          String
  path            String
  key             String
  requestHash     String
  responsePayload Json?
  statusCode      Int
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([organizationId, method, path, key])
  @@index([expiresAt])
}
